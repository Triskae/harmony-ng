* text=auto

*.md text eol=lf
*.c text eol=lf
*.h text eol=lf
*.json text eol=lf
*.sh text eol=lf
*rcS.local text eol=lf
remote/*.sh text eol=lf
remote/rcS.local text eol=lf
payload/scripts/* text eol=lf

*.ps1 text eol=crlf

payload/modules/*.ko binary
tools/unbrick_recovery/** binary
# ...except the PC-side server: a plain Python file, LF endings (a CRLF shebang line does not run).
# The other two stay byte-exact: recv_static is a MIPS program, upload_recv.sh is pasted as is
# into the Hub's serial shell. After the binary line, as later lines win.
tools/unbrick_recovery/*.py text eol=lf diff merge
*.cmd text eol=crlf

# raw IR receiver recordings (tests/test_ir_rx_decode.c)
*.i2s binary
tests/fixtures/ha/ssdp_response.txt -text

# Signed driver files: the catalog hash covers exact bytes (CRLF). Never convert.
drivers/windows/** -text
# Vendored sources (build/vendor/README.md): kept byte for byte as published upstream. The
# BearSSL tree must stay identical to its upstream commit (tests/test_build_downloads.sh checks
# its git tree hash), so no line ending rule above applies to it.
build/vendor/bearssl/** -text
build/vendor/*.tar.bz2 binary
